{
  "version": 2,
  "searches": [
    {
      "id": "example-civic",
      "name": "Honda Civic, 2017 onwards",
      "url": "https://www.autotrader.ca/cars/honda/civic/reg_on/cit_toronto/?modelyearfrom=2017",
      "enabled": true,
      "notes": "An example: replace it with your own. Run the search you want on autotrader.ca and paste the address bar. The 2026 platform drops the model, the year range and the radius out of a pasted link, so set those again under `filters` and the bot will enforce them itself.",
      "filters": {
        "models": [
          "Civic"
        ],
        "min_year": 2017,
        "near": "Toronto, ON",
        "max_distance_km": 100
      }
    }
  ],
  "filters": {
    "min_price": null,
    "max_price": null,
    "min_year": null,
    "max_year": null,
    "max_mileage_km": null,
    "include_keywords": [],
    "exclude_keywords": [],
    "exclude_sellers": [],
    "require_price": false
  },
  "notifications": {
    "digest": true,
    "dashboard_url": "",
