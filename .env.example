# For running the bot on your own machine. On GitHub, add these as repository
# secrets instead (Settings -> Secrets and variables -> Actions).
#
# Nothing reads this file by itself. Copy it to .env (git ignores that), fill
# it in, and load it into your shell before a run:
#     set -a; . ./.env; set +a

# --- Required ------------------------------------------------------------
# Encrypts everything the bot keeps. 12 characters or more; nobody can
# recover it for you.
WATCH_PASSPHRASE=
# Only while changing the passphrase: the old one, for the one check that
# re-encrypts everything under the new one (see the README's Privacy).
WATCH_PASSPHRASE_PREVIOUS=

# --- Alert channels: all optional ---------------------------------------
# With none of these set, the first check sets up ntfy on a random topic,
# which the dashboard shows once unlocked. A channel whose secrets are
# present switches itself on.

# Telegram: message @BotFather, send /newbot, copy the token. Message your
# new bot once, then open https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=

# Slack: a Slack app -> Incoming Webhooks -> Add New Webhook.
SLACK_WEBHOOK_URL=

# Email: needs 2-Step Verification, then an App Password (not your normal
# password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# SMS through Twilio. Costs money per message; the others are free.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# ntfy: an access token, only for your own server or a reserved topic.
NTFY_TOKEN=
